# Go build output
/detonate
/detonate.exe
*.exe
*.exe~
*.test
coverage.out
/detonate-results/

# Go workspace files (machine-local, never shared)
go.work
go.work.sum

# Python — for the archived M0/M1 implementation under archive/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.egg

# Virtual environments
.venv/
venv/
env/

# Local credentials and JavaScript dependencies
.env
.env.*
!.env.example
credentials.json
node_modules/

# Local databases and runtime state
*.db
*.sqlite
*.sqlite3

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# one-context local mirror. This repo is public; the mirror can carry
# cross-session working notes, so it must never be committed here.
.ctx/

# readback decision log — quotes the user verbatim and names dead ends. Same
# reason as .ctx: this repo is public, so the record is local-only by default.
.readback/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
